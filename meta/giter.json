{
  "class": "Giter",
  "desc": "Check which commit is deployed in your Kubernetes pods",
  "homepage": "https://github.com/Zhurik/giter",
  "license": "MIT",
  "bin": "giter",
  "test": {
    "args": "--version",
    "match": "version"
  },
  "platforms": {
    "macos_arm": "aarch64-apple-darwin",
    "macos_intel": "x86_64-apple-darwin",
    "linux_intel": "x86_64-unknown-linux-musl",
    "linux_arm": "aarch64-unknown-linux-musl"
  }
}
